services:
  database:
    image: postgres:16-alpine
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - yokai_database:/var/lib/postgresql/data
    networks:
      - yokai_internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U yokai_os -d yokai_os"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: ./backend
    restart: unless-stopped
    env_file:
      - .env
    depends_on:
      database:
        condition: service_healthy
    ports:
      - "127.0.0.1:8101:8000"
    networks:
      - yokai_internal

  frontend:
    build:
      context: ./frontend
    restart: unless-stopped
    ports:
      - "127.0.0.1:3101:3000"
    networks:
      - yokai_internal

networks:
  yokai_internal:

volumes:
  yokai_database:

